# ==============================================================================
# Environment Variables Template
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase — Project connection (required)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ------------------------------------------------------------------------------
# Internal API security (required)
# Used to authenticate calls to internal Next.js API routes.
# ------------------------------------------------------------------------------
API_SECRET_KEY=<generate-a-long-random-string>
ADMIN_PASSWORD=<your-admin-ui-password>

# ------------------------------------------------------------------------------
# OpenRouter — LLM gateway (required)
# https://openrouter.ai/keys
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-<your-openrouter-api-key>

# ------------------------------------------------------------------------------
# HH.ru API — OAuth 2.0 Application Credentials (required for OAuth flow)
# Register your application at: https://dev.hh.ru/admin
# These are the STATIC credentials that identify your app to the HH.ru API.
# They do NOT change per user; the per-user access/refresh tokens are stored
# in the app_settings table in Supabase.
# ------------------------------------------------------------------------------
HH_CLIENT_ID=<your-hh-app-client-id>
HH_CLIENT_SECRET=<your-hh-app-client-secret>

# ------------------------------------------------------------------------------
# Upstash QStash — Background job queue (required for async scoring pipeline)
# Dashboard: https://console.upstash.com/qstash
#
# APP_URL               — the public base URL of THIS application. Used by the
#                         QStash publisher to construct the absolute receiver URL.
#                         On Vercel: set to your production domain, e.g.:
#                         https://your-project.vercel.app
# QSTASH_TOKEN          — used by the publisher (sync-hh route) to enqueue jobs.
# QSTASH_CURRENT_SIGNING_KEY — used by verifySignatureAppRouter to authenticate
# QSTASH_NEXT_SIGNING_KEY    — incoming requests from QStash servers.
#   Rotate these in the Upstash console; keep NEXT around during key rotation.
# ------------------------------------------------------------------------------
APP_URL=https://your-project.vercel.app
QSTASH_TOKEN=<your-qstash-token>
QSTASH_CURRENT_SIGNING_KEY=sig_<your-current-signing-key>
QSTASH_NEXT_SIGNING_KEY=sig_<your-next-signing-key>


